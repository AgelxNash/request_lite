{
  "name": "postman-lite",
  "version": "0.1.0",
  "description": "Локальный аналог Postman на Electron + Vue 3",
  "type": "module",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron-vite dev",
    "build": "electron-vite build",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && electron-builder --mac",
    "smoke": "node scripts/smoke.mjs"
  },
  "build": {
    "appId": "com.romchik.postman-lite",
    "productName": "Postman Lite",
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8"
  }
}
